# =================================================================
# QuantumCrop AI — Environment Configuration (.env)
# =================================================================

# 1. Google Gemini API Key (Required for AI Pathology Advisory & Agronomist Chat)
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# 2. OpenWeatherMap API Key (Optional for Live Local Weather Telemetry)
# Get a free key from: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# 3. Server Configuration (Optional)
PORT=3000
NODE_ENV=development
